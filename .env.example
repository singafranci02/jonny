# Copy to .env.local for local dev; set the same names in Vercel for production.
# Generate the random secrets with:  openssl rand -hex 32

# Password for the dashboard
DASHBOARD_PASSWORD=

# ---- Life HQ (dashboard, Telegram, agents) ----

# Claude API key: Jonny and the area agents (Managed Agents) are driven from here
ANTHROPIC_API_KEY=

# Postgres. Vercel's Neon integration sets this automatically (POSTGRES_URL also works)
DATABASE_URL=

# Telegram bot from @BotFather, and your own chat id (send /start to the bot to see it)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Random string; Telegram sends it back with every update so we know it's really Telegram
TELEGRAM_WEBHOOK_SECRET=

# Random string; the hosted agents (and later Jarvis) use it to reach /api/mcp
MCP_TOKEN=

# Random string; the scheduler sends it to /api/cron/tick (same value as the GitHub secret)
CRON_SECRET=

# Your IANA timezone; reminders and check-ins use it (e.g. Europe/London, America/New_York)
TIMEZONE=

# Optional: your first name for the agent prompts, and the public URL
# (defaults to the Vercel production URL)
OWNER_NAME=
APP_URL=

# ---- Voice face at /talk (Jarvis on your Mac) ----
# MAC_BRAIN_URL: the tunnel URL to your Mac (e.g. https://jarvis.example.com)
# JARVIS_TOKEN:  the SAME long random string set in the Mac's Jarvis .env
MAC_BRAIN_URL=
JARVIS_TOKEN=
