# --- LLM credentials ---
# Default provider (Anthropic / Claude Sonnet 5):
ANTHROPIC_API_KEY=

# Only needed if you switch config.yaml to provider: openai_compatible
LLM_API_KEY=

# --- Later phases ---
WAKE_WORD=hey jarvis

# Shared secret so the web app can reach this Mac's brain.
# Set to a long random string (e.g. `openssl rand -hex 24`) and put the
# SAME value in the Vercel project's env vars.
JARVIS_TOKEN=

# Life HQ on Telegram (see README): bot token from @BotFather, your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Strava: workouts log themselves into Fitness. Create an app at
# strava.com/settings/api (Authorization Callback Domain: localhost), put its
# keys here, restart, then send /strava to the bot.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
